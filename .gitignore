MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tolles/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the version is
#   customized by the developer. In a product or executable, you might want to commit it.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if delegates have different platforms or dependencies,
#   it might be better to exclude Pipfile.lock.
# Pipfile.lock

# poetry
#   Similar to Pipenv, poetry.lock contains exact versions of dependencies.
#   For applications, commit it. For libraries, optionally ignore it.
# poetry.lock

# pdm
#   Similar to Pipenv and Poetry, pdm.lock contains exact versions of dependencies.
# pdm.lock
# .pdm-plugins/

# PIP / Virtualenv
.venv/
venv/
ENV/
env/

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Project specific
data/
results.json
*.xlsx
*.csv
.env
